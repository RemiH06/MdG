CREATE (natacion:Deporte {nombre: 'Natación'})
CREATE (futbol:Deporte {nombre: 'Fútbol'})
CREATE (juan:Persona {nombre: 'Juan'})
CREATE (roberto:Persona {nombre: 'Roberto'})
CREATE (luisa:Persona {nombre: 'Luisa', edad: 25})
CREATE (javier:Persona {nombre: 'Javier', edad: 20})
CREATE (pedro:Persona {nombre: 'Pedro'})
CREATE (ana:Persona {nombre: 'Ana'})

CREATE (juan)-[:PRACTICA]->(natacion)
CREATE (juan)-[:CONOCE_A]->(roberto)
CREATE (roberto)-[:PRACTICA]->(natacion)
CREATE (roberto)-[:CONOCE_A]->(luisa)
CREATE (roberto)-[:AMIGO_DE]->(pedro)
CREATE (luisa)-[:CONOCE_A]->(javier)
CREATE (luisa)-[:AMIGO_DE]->(ana)
CREATE (luisa)-[:AMIGO_DE]->(pedro)
CREATE (juan)-[:AMIGO_DE]->(pedro)
CREATE (javier)-[:PRACTICA]->(futbol)
CREATE (ana)-[:PRACTICA]->(futbol)

MATCH (n)
OPTIONAL MATCH (n)-[r]->(m)
RETURN n, r, m;